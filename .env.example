NEXT_PUBLIC_API_URL=
# Leave empty to use mock repositories. When backend exists, point this at the REST origin
# and switch getApi() to createHttpApi(process.env.NEXT_PUBLIC_API_URL).

NEXT_PUBLIC_MEDIA_BASE_URL=
# CDN domain for uploaded photos/videos when the backend stores media in a bucket
# (APP_MEDIA_STORAGE=s3), e.g. https://media.seekfactory.com. Leave empty to load media via the API.
